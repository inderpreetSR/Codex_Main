pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    server {
        listen 8080;
        server_name _;
        root /www;
        index index.html;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:8000 ${AUTH_ORIGIN}; frame-src 'self' ${AUTH_ORIGIN}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' ${AUTH_ORIGIN}; frame-ancestors 'none'" always;
        location / { try_files $uri $uri/ =404; }
    }
}
