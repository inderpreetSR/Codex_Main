FROM ghcr.io/astral-sh/uv:0.13.7 AS uv

FROM python:3.12-slim-bookworm AS base
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy UV_NO_CACHE=1
WORKDIR /srv
COPY --from=uv /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN mkdir -p /data/uploads && chown 10001:10001 /data/uploads

FROM base AS api
RUN uv sync --locked --no-dev
COPY app/ app/
COPY migrations/ migrations/
COPY alembic.ini ./
USER 10001:10001
CMD [".venv/bin/uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]

FROM base AS ai
RUN uv sync --locked --no-dev --extra ai
COPY app/ app/
USER 10001:10001
CMD [".venv/bin/python", "-c", "from app.jobs import main; main()", "ai"]

FROM base AS worker
RUN uv sync --locked --no-dev --extra worker
RUN HF_HUB_DISABLE_XET=1 .venv/bin/python -c "from huggingface_hub import snapshot_download; snapshot_download('sentence-transformers/all-MiniLM-L6-v2', revision='1110a243fdf4706b3f48f1d95db1a4f5529b4d41', local_dir='/models/minilm', allow_patterns=['*.json', '1_Pooling/config.json', 'vocab.txt', 'model.safetensors', 'README.md'])"
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
COPY app/ app/
USER 10001:10001
CMD [".venv/bin/python", "-c", "from app.jobs import main; main()"]

FROM worker AS verify
USER root
RUN uv sync --locked --no-dev --extra worker --extra ai --extra test
COPY tests/ tests/
USER 10001:10001
CMD [".venv/bin/python", "-m", "pytest", "-q", "-s", "-p", "no:cacheprovider"]
